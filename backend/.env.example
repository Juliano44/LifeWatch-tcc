# Servidor
PORT=3001
NODE_ENV=development

# Banco de dados (MariaDB) — use os mesmos dados do seu HeidiSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_node
DB_PASSWORD=senai2026
DB_NAME=banco-completo-heidisql.sql

# Autenticação (JWT)
JWT_SECRET=qualquer-texto-longo-aqui
JWT_EXPIRES_IN=7d

# CORS — endereços do frontend Vite (separados por vírgula)
